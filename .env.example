# ========================================================
# Enterprise Agentic RAG Platform - Environment Variables
# ========================================================

# General Deployment Environment (dev / prod)
ENVIRONMENT=dev
LOG_LEVEL=INFO
DEBUG=False
HOST=0.0.0.0
PORT=8000

# Security & Tenancy
DEFAULT_TENANT_ID=tenant-default
API_KEY_SECRET= # Optional shared API token for Bearer authentication

# Database Configuration
# Local Docker: postgresql+asyncpg://postgres:postgrespassword@localhost:5432/agentic_rag
# SQLite file:  sqlite+aiosqlite:///./test_agentic_rag.db
DATABASE_URL=sqlite+aiosqlite:///./test_agentic_rag.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# AWS Credentials & Region
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Amazon Bedrock Models
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_GENERATION_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_EMBEDDING_DIMENSION=1024
# Set MOCK_BEDROCK=True for offline/local development without AWS credentials
MOCK_BEDROCK=False

# Storage Configuration
# 's3' for AWS production, 'local' for local development filesystem
STORAGE_BACKEND=local
S3_BUCKET_NAME=myorg-agentic-rag-documents
LOCAL_STORAGE_DIR=./data/uploads

# Asynchronous Ingestion & Queuing
# 'sqs' for production distributed workers, 'inline' for local development
ASYNC_PROCESSING_MODE=inline
SQS_QUEUE_URL=
SQS_DLQ_URL=

# Chunking & RAG Retrieval Parameters
MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.30
MAX_RETRIEVAL_RETRIES=1
